import tkinter as tk
from tkinter import messagebox

def caesar_cipher(text, shift):
    result = ""

    for char in text:
        if 'а' <= char <= 'я':
            result += chr((ord(char) - ord('а') + shift) % 32 + ord('а'))

        elif 'А' <= char <= 'Я':
            result += chr((ord(char) - ord('А') + shift) % 32 + ord('А'))

        elif 'a' <= char <= 'z':
            result += chr((ord(char) - ord('a') + shift) % 26 + ord('a'))

        elif 'A' <= char <= 'Z':
            result += chr((ord(char) - ord('A') + shift) % 26 + ord('A'))

        else:
            result += char

    return result

def encrypt():
    word = entry_word.get()
    shift_text = entry_shift.get()

    if not word:
        messagebox.showwarning("Ошибка", "Введите слово!")
        return

    if not shift_text:
        messagebox.showwarning("Ошибка", "Введите величину сдвига!")
        return

    try:
        shift = int(shift_text)
    except ValueError:
        messagebox.showerror(
            "Ошибка",
            "Величина сдвига должна быть целым числом!"
        )
        return

    encrypted = caesar_cipher(word, shift)

    result_window = tk.Toplevel(window)
    result_window.title("Результат шифрования")
    result_window.geometry("450x200")

    tk.Label(
        result_window,
        text="Зашифрованное слово:",
        font=("Arial", 16)
    ).pack(pady=25)

    tk.Label(
        result_window,
        text=encrypted,
        font=("Arial", 24, "bold")
    ).pack(pady=15)

window = tk.Tk()
window.title("Шифр Цезаря")
window.geometry("500x350")

tk.Label(
    window,
    text="Шифр Цезаря",
    font=("Arial", 22, "bold")
).pack(pady=20)

tk.Label(
    window,
    text="Введите слово:",
    font=("Arial", 14)
).pack()

entry_word = tk.Entry(
    window,
    font=("Arial", 16),
    width=30
)
entry_word.pack(pady=10)

tk.Label(
    window,
    text="Введите величину сдвига:",
    font=("Arial", 14)
).pack()

entry_shift = tk.Entry(
    window,
    font=("Arial", 16),
    width=10
)
entry_shift.pack(pady=10)

tk.Button(
    window,
    text="Зашифровать",
    font=("Arial", 14),
    command=encrypt
).pack(pady=20)

window.mainloop()
